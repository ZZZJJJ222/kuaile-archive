.dish { margin: 16rpx 24rpx; }
.dish-head { display: flex; align-items: center; }
.emoji { font-size: 64rpx; margin-right: 16rpx; width: 64rpx; height: 64rpx; border-radius: 16rpx; }
.dish-meta { display: flex; flex-direction: column; flex: 1; }
.name { font-size: 32rpx; font-weight: 700; }
.desc { margin: 4rpx 0; }
.kcal { color: var(--accent); font-size: 24rpx; font-weight: 600; }
.opt-label { font-size: 26rpx; font-weight: 600; margin: 16rpx 0 4rpx; }
.note-input { margin-top: 8rpx; background: var(--soft); border-radius: 16rpx; padding: 16rpx; font-size: 26rpx; }
.dish-foot { display: flex; align-items: center; justify-content: space-between; margin-top: 20rpx; }
.stepper { display: flex; align-items: center; }
.step-btn { width: 56rpx; height: 56rpx; line-height: 56rpx; text-align: center; border-radius: 50%; background: var(--soft); color: var(--text); font-size: 36rpx; }
.qty { margin: 0 20rpx; font-size: 30rpx; min-width: 40rpx; text-align: center; }
.add-btn { margin: 0; font-size: 28rpx; padding: 0 36rpx; height: 72rpx; line-height: 72rpx; }
