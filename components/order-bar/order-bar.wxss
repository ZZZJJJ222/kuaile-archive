.order-bar {
  position: fixed; left: 0; right: 0; bottom: 0;
  background: var(--card);
  display: flex; align-items: center; justify-content: space-between;
  padding: 16rpx 24rpx;
  box-shadow: 0 -8rpx 24rpx rgba(0,0,0,0.06);
}
.ob-info { display: flex; flex-direction: column; }
.ob-kcal { color: var(--accent); font-weight: 700; font-size: 30rpx; }
.ob-count { font-size: 24rpx; }
.ob-btn { margin: 0; height: 72rpx; line-height: 72rpx; padding: 0 40rpx; font-size: 28rpx; }
