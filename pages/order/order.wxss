.page { min-height: 100vh; background: var(--bg); padding-bottom: 160rpx; }
.topbar { padding: 20rpx 24rpx; }
.brand { font-size: 36rpx; font-weight: 800; }
.summary { margin: 16rpx 24rpx; display: flex; align-items: center; justify-content: space-between; }
.sum-kcal { color: var(--accent); font-weight: 800; font-size: 32rpx; }
.pad { padding: 0 24rpx; }
.ex-list { display: flex; flex-direction: column; padding: 0 24rpx; }
.ex { display: flex; align-items: center; margin-bottom: 12rpx; padding: 20rpx 24rpx; }
.ex-emoji { font-size: 48rpx; margin-right: 20rpx; }
.ex-body { display: flex; flex-direction: column; }
.ex-name { font-weight: 700; font-size: 28rpx; }
.ex-min { color: var(--accent); font-size: 26rpx; }
.order-list { padding: 0 24rpx; }
.order-item { display: flex; align-items: center; margin-bottom: 12rpx; padding: 20rpx; }
.oi-emoji { font-size: 48rpx; margin-right: 16rpx; width: 72rpx; height: 72rpx; border-radius: 16rpx; }
.oi-body { flex: 1; display: flex; flex-direction: column; }
.oi-name { font-weight: 700; font-size: 30rpx; }
.stepper { display: flex; align-items: center; }
.step-btn { width: 52rpx; height: 52rpx; line-height: 52rpx; text-align: center; border-radius: 50%; background: var(--soft); color: var(--text); font-size: 34rpx; }
.qty { margin: 0 16rpx; font-size: 28rpx; min-width: 36rpx; text-align: center; }
.clear-btn { margin: 24rpx; }
.empty { display: flex; flex-direction: column; align-items: center; padding-top: 200rpx; }
.empty-emoji { font-size: 96rpx; margin-bottom: 20rpx; }
.bottom-pad { height: 40rpx; }
