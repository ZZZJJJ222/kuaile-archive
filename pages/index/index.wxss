.page { min-height: 100vh; background: var(--bg); padding-bottom: 160rpx; }
.topbar { display: flex; align-items: center; justify-content: space-between; padding: 20rpx 24rpx; }
.brand { font-size: 36rpx; font-weight: 800; }
.top-actions { display: flex; }
.icon-btn { margin-left: 20rpx; background: var(--card); border-radius: 999rpx; padding: 10rpx 20rpx; font-size: 26rpx; box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.05); }
.seg { display: flex; margin: 8rpx 24rpx 16rpx; background: var(--soft); border-radius: 999rpx; padding: 6rpx; }
.seg-item { flex: 1; text-align: center; padding: 16rpx 0; border-radius: 999rpx; font-size: 28rpx; color: var(--text); }
.seg-item.active { background: var(--primary); color: #fff; font-weight: 700; }
.cat-bar { white-space: nowrap; padding: 8rpx 16rpx; }
.cat { display: inline-block; padding: 12rpx 28rpx; margin-right: 12rpx; border-radius: 999rpx; background: var(--card); font-size: 26rpx; }
.cat.active { background: var(--accent); color: #fff; }
.dish-list { height: calc(100vh - 380rpx); }
.bottom-pad { height: 40rpx; }
.make { margin: 16rpx 24rpx; }
.make-search { display: flex; }
.make-input { flex: 1; background: var(--card); border-radius: 16rpx; padding: 18rpx; font-size: 28rpx; }
.make-btn { margin: 0 0 0 16rpx; height: 72rpx; line-height: 72rpx; font-size: 26rpx; padding: 0 30rpx; }
.make-head { display: flex; align-items: center; margin: 24rpx 0 8rpx; }
.make-emoji { font-size: 64rpx; margin-right: 16rpx; width: 96rpx; height: 96rpx; border-radius: 20rpx; }
.make-name { font-size: 32rpx; font-weight: 700; display: block; }
.ing-list { display: flex; flex-direction: column; }
.ing { display: flex; justify-content: space-between; padding: 12rpx 0; border-bottom: 1rpx solid var(--soft); }
.step { display: flex; align-items: flex-start; margin: 12rpx 0; }
.step-no { width: 40rpx; height: 40rpx; line-height: 40rpx; text-align: center; border-radius: 50%; background: var(--primary); color: #fff; font-size: 24rpx; margin-right: 16rpx; flex-shrink: 0; }
.make-empty { display: block; padding: 40rpx 0; text-align: center; }
